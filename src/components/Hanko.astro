<script>
  // Stamps the seal the first time it scrolls into view, once per page view.
  // Only runs when the site's <html> has the .reveal class (JS on, motion welcome),
  // the same switch the brush reveal uses. Re-arms after each ClientRouter page swap.
  let io: IntersectionObserver | null = null;

  function arm() {
    if (!document.documentElement.classList.contains('reveal')) return;
    io?.disconnect();
    io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-stamped');
          io?.unobserve(e.target);
        });
      },
      { threshold: 0.6 },
    );
    document.querySelectorAll('.hanko:not(.is-stamped)').forEach((el) => io?.observe(el));
  }

  document.addEventListener('astro:after-swap', arm);
  arm();
</script>
