---
import { SITE } from '../site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const onWork = path === '/' || path.startsWith('/work');
const onAbout = path === '/about';
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/">{SITE.name}</a>
    <nav class="site-nav" aria-label="Main">
      <a href="/#work" aria-current={onWork ? 'page' : undefined}>Work</a>
      <a href="/about" aria-current={onAbout ? 'page' : undefined}>About</a>
      <a href="#contact">Contact</a>
    </nav>
  </div>
</header>
