---
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}, ${SITE.tagline}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf5ea" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <ClientRouter />
    <script is:inline>
      // Turn on the brush reveal only when JS runs and motion is welcome.
      // Runs once. After each ClientRouter page swap it re-arms itself for the new page.
      (function () {
        if (window.__brushReveal) return;
        window.__brushReveal = true;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var masks = window.CSS && (CSS.supports('mask-image', 'url(x)') || CSS.supports('-webkit-mask-image', 'url(x)'));
        if (reduce || !masks || !('IntersectionObserver' in window)) return;
        var root = document.documentElement;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            var el = e.target;
            el.classList.add('is-revealed');
            el.addEventListener('transitionend', function () { el.classList.add('is-done'); }, { once: true });
            io.unobserve(el);
          });
        }, { threshold: 0.15 });
        function observe() {
          document.querySelectorAll('[data-reveal]:not(.is-revealed)').forEach(function (el) { io.observe(el); });
        }
        // Names of the images that can morph into the next page.
        function morphNames() {
          var names = [];
          document.querySelectorAll('[data-reveal][data-astro-transition-scope]').forEach(function (el) {
            names.push(getComputedStyle(el).viewTransitionName);
          });
          return names;
        }
        var previous = [];
        root.classList.add('reveal');
        document.addEventListener('DOMContentLoaded', observe);
        document.addEventListener('astro:before-swap', function () { previous = morphNames(); });
        document.addEventListener('astro:after-swap', function () {
          // The swap replaces the classes on <html>, so turn the reveal back on.
          root.classList.add('reveal');
          io.disconnect();
          // An image morphing in from the previous page arrives already painted.
          document.querySelectorAll('[data-reveal][data-astro-transition-scope]').forEach(function (el) {
            if (previous.indexOf(getComputedStyle(el).viewTransitionName) !== -1) el.classList.add('is-revealed', 'is-done');
          });
          observe();
        });
      })();
    </script>
    <script>
      import '../scripts/filters';
      import '../scripts/cursor';
      import '../scripts/card-tilt';
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
