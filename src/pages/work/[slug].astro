---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/projects';
import { SECTIONS } from '../../lib/sections';
import '../../styles/project.css';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { title, summary, section, client, year, role, cover, coverAlt, coverCaption, blend, gallery, galleryColumns } =
  project.data;
const { Content } = await render(project);

// One small line under the title: section, client, year, role.
const sectionLabel = SECTIONS.find((s) => s.key === section)?.short;
const meta = [sectionLabel, client, year, role].filter((v) => v !== undefined && v !== '');

// The cover is always the first plate, full width, so the image from the home grid
// can morph into it. Gallery images are full width unless they say span: half.
// With galleryColumns set (the older grid), they fill the columns unless span: full.
const columns = galleryColumns ?? 2;
const entries = [
  { src: cover, alt: coverAlt, caption: coverCaption, full: true, isCover: true },
  ...gallery.map((g) => ({
    src: g.src,
    alt: g.alt,
    caption: g.caption,
    isCover: false,
    full: g.span === 'full' || g.wide || (g.span === undefined && galleryColumns === undefined),
  })),
];

// Each plate also gets a large version for the lightbox.
let column = 0;
const plates = await Promise.all(
  entries.map(async (p) => {
    // Side-by-side images reveal one after another (worked out before any await, in order)
    const delay = p.full ? 0 : (column++ % columns) * 120;
    if (p.full) column = 0;
    const tall = p.src.height > p.src.width * 1.05;
    const large = await getImage({ src: p.src, width: Math.min(p.src.width, 2400) });
    const widths = p.full ? (tall ? [600, 900, 1300, 1800] : [800, 1280, 1800, 2400]) : [500, 800, 1300];
    const sizes = p.full
      ? tall
        ? '(max-width: 860px) 100vw, 900px'
        : '(max-width: 1440px) 100vw, 1280px'
      : columns === 3
        ? '(max-width: 600px) 100vw, (max-width: 860px) 50vw, 430px'
        : '(max-width: 600px) 100vw, 640px';
    return { ...p, large, delay, widths, sizes };
  }),
);
---

<Base title={title} description={summary}>
  <article class:list={['wrap', 'study', `study--${section}`]}>
    <a class="back quiet-link" href={`/#${section}`}>All work</a>

    <header class="study__head">
      <h1 class="study__title">{title}</h1>
      {meta.length > 0 && <p class="study__meta">{meta.map((m) => <span>{m}</span>)}</p>}
    </header>

    <div class:list={['plates', { 'plates--3': columns === 3 }]} style={`--columns: ${columns}`}>
      {
        plates.map((p) => {
          const image = {
            src: p.src,
            alt: p.alt,
            widths: p.widths,
            sizes: p.sizes,
            loading: p.isCover ? ('eager' as const) : ('lazy' as const),
            class: blend ? 'plate__image blend' : 'plate__image',
            style: `--reveal-delay: ${p.delay}ms`,
            'data-reveal': true,
          };
          return (
            <figure class:list={['plate', { 'plate--full': p.full, 'plate--cover': p.isCover }]}>
              <a
                class="plate__link"
                href={p.large.src}
                aria-haspopup="dialog"
                data-lightbox
                data-astro-reload
                data-caption={p.caption}
                data-width={p.large.attributes.width}
                data-height={p.large.attributes.height}
              >
                {p.isCover ? <Image {...image} transition:name={`project-${project.id}`} /> : <Image {...image} />}
              </a>
              {p.caption && <figcaption class="plate__caption">{p.caption}</figcaption>}
            </figure>
          );
        })
      }
    </div>

    <section class="notes" aria-labelledby="notes-title">
      <h2 class="notes__title" id="notes-title">Notes</h2>
      <p class="notes__summary">{summary}</p>
      <div class="notes__body">
        <Content />
      </div>
    </section>

    {
      next && next.id !== project.id && (
        <nav class="next" aria-label="Next project">
          <a href={`/work/${next.id}`}>
            <span class="next__label">Next project</span>
            <span class="next__title">{next.data.title}</span>
          </a>
        </nav>
      )
    }
  </article>

  <dialog class="lightbox" aria-label="Image viewer" data-lightbox-dialog>
    <div class="lightbox__bar">
      <p class="lightbox__count" aria-live="polite" data-lightbox-count></p>
      <button class="lightbox__close" type="button" autofocus data-lightbox-close>Close</button>
    </div>
    <div class="lightbox__stage" data-lightbox-stage>
      <img class="lightbox__image" alt="" data-lightbox-image />
    </div>
    <p class="lightbox__caption" data-lightbox-caption></p>
    <button class="lightbox__nav lightbox__nav--prev" type="button" aria-label="Previous image" data-lightbox-prev>
      <span aria-hidden="true">&larr;</span>
    </button>
    <button class="lightbox__nav lightbox__nav--next" type="button" aria-label="Next image" data-lightbox-next>
      <span aria-hidden="true">&rarr;</span>
    </button>
  </dialog>
</Base>

<script>
  import '../../scripts/lightbox';
</script>
